    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "stylelint": "^14.15.0",
    "stylelint-config-standard": "^29.0.0",
    "terser-webpack-plugin": "^5.3.6",
    "url-loader": "^4.1.1",
    "webpack": "^5.105.4",
    "webpack-bundle-analyzer": "^3.9.0",
    "webpack-cli": "5",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1",
    "zx": "^5.0.0"
  },
  "resolutions": {
    "node-abi": "^3.24.0"
  },
  "overrides": {
    "semver-regex": "^3.1.4",
    "minimist": "^1.2.7",
    "node-fetch": "^2.6.7",
    "jszip": "^3.10.1",
    "plist": "^3.0.6",
    "loader-utils": "^1.4.2",
    "terser": "^5.15.1",
    "decode-uri-component": "^0.2.2",
    "caniuse-lite": "^1.0.30001777",
    "browserslist": "^4.28.1",
    "qs": "^6.15.0",
    "json5": "^1.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "electron",
    "koffi",
    "usb"
  ]
}
