{
  "name": "openmtp",
  "productName": "OpenMTP",
  "version": "3.2.25",
  "packageManager": "bun@1.4.2",
  "description": "OpenMTP | Android File Transfer for macOS",
  "scripts": {
    "build": "bun run lint && concurrently \"bun run build-main\" \"bun run build-renderer\"",
    "build-no-verify": "concurrently \"bun run build-main\" \"bun run build-renderer\"",
    "build-main": "cross-env NODE_OPTIONS='--require @babel/register' NODE_ENV=production webpack --disable-interpret --config ./webpack/config.main.prod.babel.js --color",
    "build-renderer": "cross-env NODE_OPTIONS='--require @babel/register' NODE_ENV=production webpack --disable-interpret --config ./webpack/config.renderer.prod.babel.js --color",
    "dev": "node ./internals/scripts/ensure-electron.js && cross-env NODE_ENV=development START_HOT=1 node -r @babel/register ./internals/scripts/CheckPortInUse.js && cross-env START_HOT=1 bun run start-renderer-dev",
    "dev-kalam-ffi": "bun run build-native && bun run dev",
    "package": "bun run build && electron-builder --config electron-builder-config.js build --publish never",
    "package-all": "bun run build && electron-builder --config electron-builder-config.js build -mwl --publish never",
    "package-mac": "bun run build && electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-no-verify": "bun run build-no-verify && electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-without-notarize": "bun run build && cross-env ELECTRON_NOTARIZE=NO electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-without-notarize-no-verify": "bun run build-no-verify && cross-env ELECTRON_NOTARIZE=NO electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-linux": "bun run build && electron-builder --config electron-builder-config.js build --linux --publish never",
    "package-win": "bun run build && electron-builder --config electron-builder-config.js build --win --x64 --publish never",
    "prestart": "bun run build",
    "start": "cross-env NODE_ENV=production node ./internals/scripts/run-electron.js ./app/main.prod.js",
    "start-main-dev": "node ./internals/scripts/ensure-electron.js && cross-env START_HOT=1 NODE_ENV=development node ./internals/scripts/run-electron.js ./app/main.dev.entry.js",
    "start-renderer-dev": "cross-env NODE_OPTIONS='--require @babel/register' NODE_ENV=development webpack serve --disable-interpret --config webpack/config.renderer.dev.babel.js",
    "publish-mac": "bun run build && electron-builder --config electron-builder-config.js build --mac --publish always",
    "publish-mac-no-verify": "bun run build-no-verify && cross-env electron-builder --config electron-builder-config.js build --mac --publish always",
    "dev-docs": "cross-env NODE_ENV=development webpack serve --config docs-sources/webpack/webpack.config.base.js",
    "build-docs": "cross-env NODE_ENV=production webpack --config docs-sources/webpack/webpack.config.base.js",
    "lint": "oxlint --ignore-path .eslintignore .",
    "format": "oxfmt --ignore-path .eslintignore --write .",
    "format:check": "oxfmt --ignore-path .eslintignore --check .",
    "lint-styles": "stylelint --ignore-path .eslintignore '**/*.*(css|scss)' --custom-syntax postcss-scss",
    "lint-staged": "lint-staged",
    "lint-fix": "oxlint --ignore-path .eslintignore --fix . && bun run format",
    "lint-styles-fix": "bun run lint-styles --fix && bun run format",
    "prepare": "husky",
    "preinstall": "node ./internals/scripts/CheckYarn.js",
    "postinstall": "node ./internals/scripts/ensure-electron.js && node ./internals/scripts/install-app-deps.js",
    "ensure-electron": "node ./internals/scripts/ensure-electron.js",
    "test": "bun test --preload ./app/test/electron-mock.js ./app",
    "test:watch": "bun test --watch --preload ./app/test/electron-mock.js ./app",
    "test:startup": "bun scripts/test-startup.mjs",
    "test:smoke": "cross-env NODE_ENV=production node ./internals/scripts/run-electron.js ./scripts/smoke-electron.cjs",
    "benchmark:window": "bun scripts/benchmark-directory-window.js",
    "benchmark:directory": "bun scripts/benchmark-local-directory.js",
    "benchmark": "bun run benchmark:window && bun run benchmark:directory",
    "build-native": "node ./ffi/kalam/native/scripts/build-host.mjs",
    "build-libusb": "node ./ffi/kalam/native/scripts/build-libusb.mjs",
    "test:manual": "bun tests/manual/run.mjs"
  },
  "main": "./app/main.prod.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaditagrawal/openmtp.git"
  },
  "author": {
    "name": "Ganesh Rathinavel",
    "email": "ganeshrvel@outlook.com",
    "url": "https://www.linkedin.com/in/ganeshrvel/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aaditagrawal/openmtp/issues/"
  },
  "keywords": [
    "openmtp",
    "android",
    "file-transfer",
    "macOS",
    "mtp"
  ],
  "homepage": "https://openmtp.ganeshrvel.com/",
  "browserslist": {
    "production": [
      "last 2 Chrome versions"
    ],
    "development": [
      "last 2 Chrome versions"
    ]
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@fontsource/dm-mono": "^5.3.0",
    "@sentry/electron": "^7.20.0",
    "@sindresorhus/is": "^8.1.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "electron-is": "^3.0.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.1",
    "hotkeys-js": "^4.0.8",
    "junk": "^4.0.1",
    "koffi": "^3.3.2",
    "lucide-react": "^1.50.0",
    "macos-version": "^6.0.0",
    "mixpanel-browser": "^2.83.0",
    "node-mac-permissions": "^2.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0",
    "sanitize-html": "^2.18.0",
    "semver": "^7.8.5",
    "source-map-support": "^0.5.21",
    "usb": "^3.1.0",
    "uuid": "^14.0.2",
    "@mui/material": "^9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "tss-react": "^4.9.21",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@electron/notarize": "^3.1.1",
    "@sentry/cli": "^3.8.0",
    "@sentry/webpack-plugin": "^5.4.0",
    "@shadcn/lint": "^0.2.0",
    "babel-loader": "^10.1.1",
    "electron-debug": "^5.0.0",
    "milligram": "^1.4.1",
    "normalize.css": "^8.0.1",
    "browserslist": "^4.29.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "redux-logger": "^3.0.6",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1",
    "zx": "^8.8.5",
    "@electron/get": "^5.1.0",
    "package-directory": "^8.2.0",
    "postcss-scss": "^4.0.9",
    "stylelint-config-recommended-scss": "^17.0.1"
  },
  "engines": {
    "node": "^22.22.1 || >=24.11.0",
    "bun": ">=1.4.2"
  },
  "trustedDependencies": [
    "electron",
    "koffi",
    "usb",
    "node-mac-permissions"
  ],
  "type": "commonjs"
}
