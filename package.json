{
  "name": "openmtp",
  "productName": "OpenMTP",
  "version": "3.2.25",
  "packageManager": "bun@1.3.10",
  "description": "OpenMTP | Android File Transfer for macOS",
  "scripts": {
    "build": "node ./internals/scripts/run-package-script.js lint && concurrently \"node ./internals/scripts/run-package-script.js build-main\" \"node ./internals/scripts/run-package-script.js build-renderer\"",
    "build-no-verify": "concurrently \"node ./internals/scripts/run-package-script.js build-main\" \"node ./internals/scripts/run-package-script.js build-renderer\"",
    "build-dll": "cross-env NODE_OPTIONS='--openssl-legacy-provider --require @babel/register' NODE_ENV=development webpack --disable-interpret --config ./webpack/config.renderer.dev.dll.babel.js --color",
    "build-main": "cross-env NODE_OPTIONS='--openssl-legacy-provider --require @babel/register' NODE_ENV=production webpack --disable-interpret --config ./webpack/config.main.prod.babel.js --color",
    "build-renderer": "cross-env NODE_OPTIONS='--openssl-legacy-provider --require @babel/register' NODE_ENV=production webpack --disable-interpret --config ./webpack/config.renderer.prod.babel.js --color",
    "dev": "node ./internals/scripts/ensure-electron.js && cross-env NODE_ENV=development START_HOT=1 node -r @babel/register ./internals/scripts/CheckPortInUse.js && cross-env START_HOT=1 node ./internals/scripts/run-package-script.js start-renderer-dev",
    "dev-kalam-ffi": "./ffi/kalam/native/scripts/build.sh && node ./internals/scripts/run-package-script.js dev",
    "package": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build --publish never",
    "package-all": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build -mwl --publish never",
    "package-mac": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-no-verify": "node ./internals/scripts/run-package-script.js build-no-verify && electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-without-notarize": "node ./internals/scripts/run-package-script.js build && cross-env ELECTRON_NOTARIZE=NO electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-mac-without-notarize-no-verify": "node ./internals/scripts/run-package-script.js build-no-verify && cross-env ELECTRON_NOTARIZE=NO electron-builder --config electron-builder-config.js build --mac --publish never",
    "package-linux": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build --linux --publish never",
    "package-win": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build --win --x64 --publish never",
    "prestart": "node ./internals/scripts/run-package-script.js build",
    "start": "cross-env NODE_ENV=production ./app/main.prod.js",
    "start-main-dev": "node ./internals/scripts/ensure-electron.js && cross-env START_HOT=1 NODE_ENV=development run-electron ./app/main.dev.entry.js",
    "start-renderer-dev": "cross-env NODE_OPTIONS='--openssl-legacy-provider --require @babel/register' NODE_ENV=development webpack serve --disable-interpret --config webpack/config.renderer.dev.babel.js",
    "publish-mac": "node ./internals/scripts/run-package-script.js build && electron-builder --config electron-builder-config.js build --mac --publish always",
    "publish-mac-no-verify": "node ./internals/scripts/run-package-script.js build-no-verify && cross-env electron-builder --config electron-builder-config.js build --mac --publish always",
    "dev-docs": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack serve --config docs-sources/webpack/webpack.config.base.js",
    "build-docs": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --config docs-sources/webpack/webpack.config.base.js && git add .",
    "lint": "oxlint --ignore-path .eslintignore .",
    "format": "oxfmt --ignore-path .eslintignore --write .",
    "format:check": "oxfmt --ignore-path .eslintignore --check .",
    "lint-styles": "stylelint --ignore-path .eslintignore '**/*.*(css|scss)' --custom-syntax postcss-scss",
    "lint-staged": "lint-staged",
    "lint-fix": "oxlint --ignore-path .eslintignore --fix . && node ./internals/scripts/run-package-script.js format; exit 0",
    "lint-styles-fix": "node ./internals/scripts/run-package-script.js lint-styles --fix && node ./internals/scripts/run-package-script.js format; exit 0",
    "prepare": "husky",
    "preinstall": "internals/scripts/preinstall.sh",
    "postinstall": "node ./internals/scripts/ensure-electron.js && node ./internals/scripts/maybe-build-dll.js && node ./internals/scripts/install-app-deps.js",
    "ensure-electron": "node ./internals/scripts/ensure-electron.js",
    "test": "bun test --preload ./app/test/electron-mock.js ./app",
    "test:watch": "bun test --watch --preload ./app/test/electron-mock.js ./app"
  },
  "main": "./app/main.prod.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganeshrvel/openmtp.git"
  },
  "author": {
    "name": "Ganesh Rathinavel",
    "email": "ganeshrvel@outlook.com",
    "url": "https://www.linkedin.com/in/ganeshrvel/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ganeshrvel/openmtp/issues/"
  },
  "keywords": [
    "openmtp",
    "android",
    "file-transfer",
    "macOS",
    "mtp"
  ],
  "homepage": "https://openmtp.ganeshrvel.com/",
  "browserslist": {
    "production": [
      "last 2 Chrome versions"
    ],
    "development": [
      "last 2 Chrome versions"
    ]
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@fontsource/dm-mono": "^5.3.0",
    "@material-ui/core": "^4.12.4",
    "@sentry/electron": "^7.10.0",
    "@sindresorhus/is": "^4.4.0",
    "classnames": "^2.3.1",
    "dayjs": "^1.10.7",
    "electron-is": "^3.0.0",
    "electron-is-packaged": "^1.0.2",
    "electron-root-path": "^1.1.0",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.4",
    "glob": "^7.2.0",
    "hotkeys-js": "^4.0.2",
    "junk": "^3.1.0",
    "koffi": "^2.15.2",
    "lucide-react": "^1.30.0",
    "macos-version": "5.2.1",
    "mixpanel-browser": "^2.75.0",
    "nice-utils": "^1.0.3",
    "node-mac-permissions": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.13.1",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "reselect": "^4.1.8",
    "sanitize-html": "^2.17.1",
    "semver": "^7.7.4",
    "source-map-support": "^0.5.21",
    "styled-components": "^4.4.1",
    "usb": "^2.17.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-proposal-do-expressions": "^7.28.6",
    "@babel/plugin-proposal-export-default-from": "^7.27.1",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-function-bind": "^7.27.1",
    "@babel/plugin-proposal-function-sent": "^7.27.1",
    "@babel/plugin-proposal-json-strings": "^7.18.6",
    "@babel/plugin-proposal-logical-assignment-operators": "^7.20.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-pipeline-operator": "^7.28.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-throw-expressions": "^7.27.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/plugin-transform-react-constant-elements": "^7.27.1",
    "@babel/plugin-transform-react-inline-elements": "^7.27.1",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/register": "^7.28.6",
    "@electron/notarize": "^3.1.1",
    "@sentry/cli": "^3.3.2",
    "@sentry/webpack-plugin": "^1.20.0",
    "@shadcn/lint": "^0.1.0",
    "babel-loader": "^8.4.1",
    "electron-debug": "^3.2.0",
    "milligram": "^1.4.1",
    "normalize.css": "^8.0.1",
    "run-electron": "^1.0.0",
    "babel-plugin-dev-expression": "^0.2.3",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "browserslist": "^4.28.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "41.0.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-download": "^4.1.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
